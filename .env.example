APP_NAME=local-ai-gateway
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO

# Preferred development mode: FastAPI runs directly in WSL/Linux and the
# infrastructure containers are published only on localhost.
DATABASE_URL=postgresql+asyncpg://local_ai:local_ai_change_me@127.0.0.1:5432/local_ai
REDIS_URL=redis://127.0.0.1:6379/0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_REGISTRY_BASE_URL=https://ollama.com
QDRANT_BASE_URL=http://127.0.0.1:6333

# Host ports used by Docker Compose. Change them here if a local port conflicts.
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Aliases are optional. Installed Ollama model names can be used directly.
MODEL_ALIASES={}
INFERENCE_DEFAULT_MAX_OUTPUT_TOKENS=256
INFERENCE_DEFAULT_REASONING_EFFORT=none

RAG_ENABLED=true
RAG_EMBEDDING_MODEL=embeddinggemma
RAG_DEFAULT_COLLECTION=local_knowledge
RAG_CHUNK_SIZE_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=160
RAG_DEFAULT_TOP_K=5
OLLAMA_EMBEDDING_KEEP_ALIVE=15m

AGENT_DEFAULT_MEMORY_MESSAGES=12

BOOTSTRAP_API_KEY=sk-local-dev-change-me
BOOTSTRAP_API_KEY_NAME=bootstrap-dev
LOCAL_UI_ENABLED=true
LOCAL_UI_API_KEY_NAME=local-ui

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# make run overrides this to true. make run-cpu overrides it to false.
GPU_TELEMETRY_ENABLED=false
GPU_SAMPLE_INTERVAL_MS=100
NVIDIA_GPU_INDEX=0
ELECTRICITY_PRICE_PER_KWH=

POSTGRES_DB=local_ai
POSTGRES_USER=local_ai
POSTGRES_PASSWORD=local_ai_change_me
